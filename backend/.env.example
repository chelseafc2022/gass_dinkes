NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://gass:gass_local@localhost:5432/gass?schema=public
JWT_ACCESS_SECRET=
FRONTEND_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
# SELECT-only user; never copy production credentials into source control.
EGOV_DB_HOST=
EGOV_DB_PORT=3306
EGOV_DB_USER=
EGOV_DB_PASSWORD=
# Existing eGov/Simpeg NIP for the first GASS administrator.
BOOTSTRAP_ADMIN_NIP=
BOOTSTRAP_ADMIN_NAME=Administrator Dinkes
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# AI pimpinan (optional). Server-only; never use EXPO_PUBLIC_* for these values.
AI_ENABLED=false
OPENAI_API_KEY=
# Choose a model enabled in your OpenAI project with Responses function calling.
OPENAI_MODEL=
# Global request budget per Asia/Makassar day, shared via REDIS_URL.
AI_DAILY_REQUEST_LIMIT=200
